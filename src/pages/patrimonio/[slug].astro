---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { categoryPath, demoteBodyHeadings, formatDate, imageSrc, isoDate, plainText } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('patrimonio');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const mainImage = imageSrc(data.mainImage);
const description = plainText(data.bodyHtml).slice(0, 160);
const categoryHref = categoryPath(data.category);
---

<BaseLayout title={data.title} description={description} image={mainImage}>
  <main>
    <header class="article-header article-header--editorial container container--article">
      <p class="article-meta">
        {data.category && (categoryHref ? <a href={categoryHref}>{data.category}</a> : <span>{data.category}</span>)}
        {data.publishedOn && <time datetime={isoDate(data.publishedOn) || undefined}>{formatDate(data.publishedOn)}</time>}
      </p>
      <h1>{data.title}</h1>
    </header>
    {mainImage && (
      <figure class="article-media">
        <img src={mainImage} alt={data.title} decoding="async" fetchpriority="high" />
      </figure>
    )}
    <article class="article-content container container--article" set:html={demoteBodyHeadings(data.bodyHtml)} />
    <Gallery items={data.gallery} title={data.title} />
    <VideoEmbed url={data.video} title={data.title} />
  </main>
</BaseLayout>
