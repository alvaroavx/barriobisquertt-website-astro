---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteScripts from '../components/SiteScripts.astro';
import { assets, metaDescription, site } from '../lib/site';
import '../styles/global.css';
import '../styles/layout.css';

interface Props {
  title?: string;
  description?: string | null;
  image?: string | null;
  hideHeader?: boolean;
  noIndex?: boolean;
}

const {
  title = site.name,
  description = site.description,
  image = null,
  hideHeader = false,
  noIndex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || site.url).toString();
const pageTitle = title === site.name ? site.name : `${title} - ${site.name}`;
const pageDescription = metaDescription(description);
const socialImage = new URL(image || assets.socialImage, Astro.site || site.url).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#organization`,
      name: site.name,
      url: site.url,
      logo: new URL(assets.logoBlack, site.url).toString(),
      sameAs: [site.instagram],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      name: site.name,
      url: site.url,
      inLanguage: site.locale,
      publisher: { '@id': `${site.url}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/barrio-bisquertt/mirror/img/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#f7f4f5" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a>
    {!hideHeader && <Header currentPath={Astro.url.pathname} />}
    <div id="contenido-principal" tabindex="-1">
      <slot />
    </div>
    <Footer />
    <SiteScripts />
  </body>
</html>
