---
import { navigationItems, formConfig } from '../data/navigation';
import { assets, site } from '../lib/site';

const formEnabled = Boolean(formConfig.endpoint);
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" aria-label="Ir al inicio de Barrio Bisquertt">
        <img src={assets.logoWhite} alt="Barrio Bisquertt" width="268" height="104" />
      </a>
      <div class="footer-links">
        <a href={site.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram de Barrio Bisquertt (abre en una pestaña nueva)">
          <img class="footer-instagram" src={assets.instagram} alt="Instagram" width="42" height="42" />
        </a>
        {navigationItems.slice().reverse().map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </div>
    </div>

    <div class="footer-contact">
      <h2>Proyecto financiado e impulsado por Gobierno Regional de O'Higgins junto con su Consejo Regional y ejecutado por Sercotec.</h2>
      <form
        class="footer-form"
        method="post"
        action={formEnabled ? formConfig.endpoint : undefined}
        data-contact-form
        data-enabled={formEnabled ? 'true' : 'false'}
        data-ajax-endpoint={formEnabled ? formConfig.ajaxEndpoint : undefined}
        data-sending-message={formConfig.sendingMessage}
        data-success-message={formConfig.successMessage}
        data-error-message={formConfig.errorMessage}
      >
        {formEnabled && (
          <>
            <input type="hidden" name="_subject" value={formConfig.subject} />
            <input type="hidden" name="_template" value="table" />
            <input class="footer-form__honey" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
          </>
        )}
        <label for="footer-email">Correo electrónico</label>
        <input id="footer-email" name="email" type="email" autocomplete="email" placeholder="nombre@ejemplo.cl" required disabled={!formEnabled} />
        <button type="submit" disabled={!formEnabled}>Enviar</button>
        <p class="form-status" data-form-status role="status">{formEnabled ? '' : formConfig.disabledMessage}</p>
      </form>
      <div class="institutional-logos" aria-label="Logos institucionales">
        <img src={assets.gore} alt="Gobierno Regional de O'Higgins" loading="lazy" />
        <img src={assets.sercotec} alt="Sercotec" loading="lazy" />
        <img src={assets.barrios} alt="Barrios Comerciales" loading="lazy" />
      </div>
      <p class="site-credit">Implementado por <a href="https://avx.cl/" target="_blank" rel="noopener noreferrer">AVX Informática<span class="sr-only"> (abre en una pestaña nueva)</span></a></p>
    </div>
  </div>
</footer>
