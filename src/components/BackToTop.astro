---
// Boton fijo para volver arriba. Aparece recien cuando hay scroll
// (logica en SiteScripts); sin JavaScript queda oculto y no estorba.
---

<button class="back-to-top" type="button" data-back-to-top hidden>
  <span class="sr-only">Volver arriba</span>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d="M12 19V5"></path>
    <path d="m5.5 11.5 6.5-6.5 6.5 6.5"></path>
  </svg>
</button>
