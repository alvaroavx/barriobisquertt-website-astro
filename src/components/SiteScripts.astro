<script is:inline>
  const header = document.querySelector('[data-site-header]');
  const toggle = header?.querySelector('.menu-toggle');
  const nav = header?.querySelector('.site-nav');

  function closeMenu({ restoreFocus = false } = {}) {
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Abrir menú');
    nav?.classList.remove('is-open');
    document.body.classList.remove('menu-open');
    if (restoreFocus) toggle?.focus();
  }

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    toggle.setAttribute('aria-label', expanded ? 'Abrir menú' : 'Cerrar menú');
    nav?.classList.toggle('is-open', !expanded);
    document.body.classList.toggle('menu-open', !expanded);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu({ restoreFocus: true });
    }
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.querySelectorAll('[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      if (form.getAttribute('data-enabled') !== 'true') {
        event.preventDefault();
      }
    });
  });

  document.querySelectorAll('[data-gallery]').forEach((gallery) => {
    const lightbox = gallery.querySelector('[data-lightbox]');
    const lightboxImage = gallery.querySelector('[data-lightbox-image]');
    const caption = gallery.querySelector('[data-lightbox-caption]');
    const items = [...gallery.querySelectorAll('[data-lightbox-open]')];
    let currentIndex = 0;
    let opener = null;

    function show(index) {
      const item = items[index];
      if (!item || !lightboxImage) return;
      currentIndex = index;
      lightboxImage.src = item.getAttribute('data-full-src');
      lightboxImage.alt = item.getAttribute('data-alt') || '';
      if (caption) caption.textContent = item.getAttribute('data-alt') || '';
      if (!lightbox?.open) lightbox?.showModal();
      lightbox?.querySelector('[data-lightbox-close]')?.focus();
    }

    items.forEach((button, index) => {
      button.addEventListener('click', () => {
        opener = button;
        show(index);
      });
    });

    lightbox?.querySelector('[data-lightbox-close]')?.addEventListener('click', () => {
      lightbox.close();
    });

    lightbox?.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => {
      show((currentIndex - 1 + items.length) % items.length);
    });

    lightbox?.querySelector('[data-lightbox-next]')?.addEventListener('click', () => {
      show((currentIndex + 1) % items.length);
    });

    lightbox?.addEventListener('close', () => opener?.focus());
    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) lightbox.close();
    });
  });

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll('[data-ambient-video]').forEach((video) => {
    const control = video.closest('.home-hero')?.querySelector('[data-video-toggle]');
    function updateVideoControl() {
      if (control) control.textContent = video.paused ? 'Reproducir video' : 'Pausar video';
    }

    if (reducedMotion.matches) {
      video.pause();
      video.removeAttribute('autoplay');
    }

    control?.addEventListener('click', () => {
      if (video.paused) video.play();
      else video.pause();
      updateVideoControl();
    });
    video.addEventListener('play', updateVideoControl);
    video.addEventListener('pause', updateVideoControl);
    updateVideoControl();
  });
</script>
