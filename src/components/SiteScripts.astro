<script is:inline>
  const header = document.querySelector('[data-site-header]');
  const toggle = header?.querySelector('.menu-toggle');
  const nav = header?.querySelector('.site-nav');

  function closeMenu() {
    toggle?.setAttribute('aria-expanded', 'false');
    nav?.classList.remove('is-open');
  }

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    nav?.classList.toggle('is-open', !expanded);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu();
      document.querySelector('[data-lightbox].is-open')?.classList.remove('is-open');
    }
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Header de vidrio apenas el contenido empieza a pasar por debajo.
  if (header) {
    const syncHeader = () => {
      header.classList.toggle('is-glass', window.scrollY > 64);
    };

    syncHeader();
    window.addEventListener('scroll', syncHeader, { passive: true });
    window.addEventListener('resize', syncHeader);
  }

  document.querySelectorAll('[data-contact-form]').forEach((form) => {
    const status = form.querySelector('[data-form-status]');
    const submit = form.querySelector('button[type="submit"]');
    const ajaxEndpoint = form.getAttribute('data-ajax-endpoint');

    form.addEventListener('submit', async (event) => {
      if (form.getAttribute('data-enabled') !== 'true') {
        event.preventDefault();
        return;
      }
      // Sin endpoint JSON se deja el POST HTML normal al receptor.
      if (!ajaxEndpoint) return;

      event.preventDefault();
      if (status) status.textContent = form.getAttribute('data-sending-message') || '';
      submit?.setAttribute('disabled', '');

      try {
        const response = await fetch(ajaxEndpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || String(result.success) !== 'true') {
          throw new Error(result.message || response.statusText);
        }
        form.reset();
        if (status) status.textContent = form.getAttribute('data-success-message') || '';
      } catch {
        if (status) status.textContent = form.getAttribute('data-error-message') || '';
      } finally {
        submit?.removeAttribute('disabled');
      }
    });
  });

  document.querySelectorAll('[data-gallery]').forEach((gallery) => {    const lightbox = gallery.querySelector('[data-lightbox]');
    const lightboxImage = gallery.querySelector('[data-lightbox-image]');
    const caption = gallery.querySelector('[data-lightbox-caption]');
    const items = [...gallery.querySelectorAll('[data-lightbox-open]')];
    let currentIndex = 0;

    function show(index) {
      const item = items[index];
      if (!item || !lightboxImage) return;
      currentIndex = index;
      lightboxImage.src = item.getAttribute('data-full-src');
      lightboxImage.alt = item.getAttribute('data-alt') || '';
      if (caption) caption.textContent = item.getAttribute('data-alt') || '';
      lightbox?.classList.add('is-open');
      lightbox?.querySelector('[data-lightbox-close]')?.focus();
    }

    items.forEach((button, index) => {
      button.addEventListener('click', () => show(index));
    });

    lightbox?.querySelector('[data-lightbox-close]')?.addEventListener('click', () => {
      lightbox.classList.remove('is-open');
    });

    lightbox?.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => {
      show((currentIndex - 1 + items.length) % items.length);
    });

    lightbox?.querySelector('[data-lightbox-next]')?.addEventListener('click', () => {
      show((currentIndex + 1) % items.length);
    });
  });

  // Boton volver arriba: aparece pasados 400 px de scroll y devuelve el foco
  // al inicio para no perderlo cuando el boton se oculta.
  const backToTop = document.querySelector('[data-back-to-top]');
  if (backToTop) {
    const UMBRAL = 400;
    const syncBackToTop = () => {
      backToTop.toggleAttribute('hidden', window.scrollY < UMBRAL);
    };

    syncBackToTop();
    window.addEventListener('scroll', syncBackToTop, { passive: true });

    backToTop.addEventListener('click', () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
      document.querySelector('.site-logo')?.focus({ preventScroll: true });
    });
  }
</script>

