---
import { navigationItems } from '../data/navigation';
import { assets } from '../lib/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function isActive(item: (typeof navigationItems)[number]) {
  if (item.href === '/') return currentPath === '/';
  return item.activePrefixes.some((prefix) => currentPath === prefix || currentPath.startsWith(`${prefix}/`));
}
---

<header class="site-header" data-site-header>
  <a class="site-logo" href="/" aria-label="Ir al inicio de Barrio Bisquertt">
    <img src={assets.logoBlack} alt="Barrio Bisquertt" width="121" height="47" />
  </a>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Abrir menú">
    <span class="sr-only">Abrir menú</span>
    <span></span>
    <span></span>
  </button>

  <nav id="site-navigation" class="site-nav" aria-label="Navegación principal">
    {navigationItems.map((item) => (
      <a
        class:list={['site-nav__link', { 'is-active': isActive(item) }]}
        href={item.href}
        aria-current={isActive(item) ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>
